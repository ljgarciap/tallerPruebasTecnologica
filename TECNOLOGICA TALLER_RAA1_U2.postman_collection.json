            "exec": [
              "// Validación de Código de Estado",
              "pm.test(\"HTTP Status 201 - Usuario Creado con éxito\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Validación de la Estructura de Respuesta del Controlador",
              "pm.test(\"Validar estructura JSON de éxito\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.mensaje).to.eql(\"Usuario registrado con éxito\");",
              "    pm.expect(jsonData.usuario).to.eql(\"luis_garcia\");",
              "    pm.expect(jsonData.status).to.eql(\"ACTIVO\");",
              "});"
            ],
